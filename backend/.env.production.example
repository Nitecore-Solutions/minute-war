# ---------------------------------------------------------------------------
# Production backend environment (Render + Aiven MySQL).
#
# Copy the values into the Render service's Environment tab. Do not commit a
# filled-in copy of this file.
#
# Render sets PORT itself for a web service; do not hard-code a port here.
# The start command is:
#   npx next start -p $PORT
# ---------------------------------------------------------------------------

NODE_ENV=production
NODE_VERSION=22

# Aiven MySQL Service URI. Keep the ?ssl-mode=REQUIRED suffix.
DATABASE_URL=mysql://avnadmin:REPLACE_WITH_AIVEN_PASSWORD@mysql-REPLACE-SERVICE.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED

# Render Hobby/Free and Aiven free tiers are small. Five connections is enough
# for a test deployment; raise it only after checking Aiven's connection limit.
DB_POOL_SIZE=5

# Keep TLS on. If Node cannot verify Aiven's CA from the system store, paste
# the Aiven CA PEM into DB_SSL_CA (with real newlines) or use the base64 form.
DB_SSL=true
# DB_SSL_CA_BASE64=LS0tLS1CRUdJTiBDRVJUSUZJQ0FURS0tLS0t...
# DB_SSL_REJECT_UNAUTHORIZED=true

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Never reuse the development value.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_TTL_DAYS=30

# Public origin of this Render service. Used for share links, metadata and
# the legal pages. Replace <service> with the actual Render service name.
APP_ORIGIN=https://REPLACE-SERVICE.onrender.com
SHARE_BASE_URL=https://REPLACE-SERVICE.onrender.com

# WebSocket service is intentionally not deployed for the first release.
# Leave EXPO_PUBLIC_ENABLE_BATTLES=false on the mobile build.
