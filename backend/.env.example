# ---------------------------------------------------------------------------
# Backend environment. Copy to `.env` (gitignored) and fill in.
#
# Nothing here ever ships in the mobile app. The app only receives the
# public API + WebSocket URLs.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local MySQL 8. `minute_war` database + dedicated app user.
#
# Cloud migration later: change only this line. Nothing else references the
# host. For most managed providers (PlanetScale, Aiven, TiDB, Railway) the
# URL format is identical.
DATABASE_URL=mysql://minute_war:Mw%232026_Local%21xQ7@127.0.0.1:3306/minute_war

# Only needed by `npm run db:migrate` on a machine where the database does not
# exist yet, or for --reset. Prefer the app user everywhere else.
# DATABASE_ADMIN_URL=mysql://root:6387@127.0.0.1:3306/

# Managed MySQL usually requires TLS. A service URI containing
# `?ssl-mode=REQUIRED` is detected automatically; these are for providers
# whose CA is not already trusted by Node.
# DB_SSL=true
# DB_SSL_CA_BASE64=LS0tLS1CRUdJTiBDRVJUSUZJQ0FURS0tLS0t...
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- Sessions --------------------------------------------------------------
# At least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev_only_secret_change_me_before_any_deploy_2f8a1c9d4b7e0356
JWT_TTL_DAYS=30

# --- Ports -----------------------------------------------------------------
PORT=3000
WS_PORT=3002

# --- App -------------------------------------------------------------------
NODE_ENV=development

# Where the admin dashboard thinks it lives. Used for share-link building.
APP_ORIGIN=http://localhost:3000

# --- Economy tuning (overridable at runtime in /admin/settings) ------------
DAILY_GAME_COUNT=3
COIN_SIGNUP_BONUS=500
COIN_DAILY_LOGIN=50