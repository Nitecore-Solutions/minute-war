# ---------------------------------------------------------------------------
# Mobile app environment.
#
# EXPO_PUBLIC_* values are INLINED INTO THE APP AT BUILD TIME. Changing this
# file later does NOT change an already-installed app - you must rebuild.
#
# Pick the value that matches how you are running:
#
#   Android emulator (AVD)  ->  http://10.0.2.2:3000/api
#   iOS simulator           ->  http://localhost:3000/api
#   Physical phone on WiFi  ->  http://<your-PC-LAN-IP>:3000/api
#   Production              ->  https://api.yourdomain.com/api
#
# A physical phone cannot use localhost: that points at the phone itself.
# Find this PC's IP with:  ipconfig
#
# AUTO-GENERATED by tools/start-all.ps1 when tunnels are used - do not
# hand-edit in that case.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_API_URL=http://192.168.56.1:3000/api

# Derived from the API base when omitted (:3000 -> :3002).
# EXPO_PUBLIC_WS_URL=ws://localhost:3002

# Set to true only when the WebSocket server is running/deployed.
# When false or omitted, the app never opens a socket and battle/challenge
# screens and buttons are hidden. Everything else works over the REST API.
EXPO_PUBLIC_ENABLE_BATTLES=false