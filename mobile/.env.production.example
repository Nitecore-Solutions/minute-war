# ---------------------------------------------------------------------------
# Mobile production environment.
#
# For a local EAS build: copy this file to .env.production (gitignored) and
# replace the Render URL. For a cloud build, use an EAS environment variable
# instead so the value is not committed:
#
#   eas env:create --name EXPO_PUBLIC_API_URL \
#     --value https://YOUR-SERVICE.onrender.com/api \
#     --environment production --visibility plaintext
#
# The production build profile in eas.json already loads the `production`
# EAS environment. EXPO_PUBLIC_* values are baked in at build time.
# ---------------------------------------------------------------------------

# The public Render URL, including /api. Do not add a trailing slash.
EXPO_PUBLIC_API_URL=https://YOUR-SERVICE.onrender.com/api

# Battles and friend challenges are intentionally disabled for the first
# release. With this false, the app never opens a WebSocket and hides the
# battle/challenge UI. Do not set EXPO_PUBLIC_WS_URL.
EXPO_PUBLIC_ENABLE_BATTLES=false
